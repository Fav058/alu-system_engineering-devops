#!/usr/bin/env bash
# Installs nginx and adds a custom X-Served-By header holding the server hostname

sudo apt-get update -y
sudo apt-get install -y nginx
echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null

if ! grep -rq "X-Served-By" /etc/nginx/
then
    sudo sed -i '/^http {/a \\tadd_header X-Served-By $hostname;' /etc/nginx/nginx.conf
fi

sudo nginx -t
sudo service nginx restart
