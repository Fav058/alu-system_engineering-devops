#!/usr/bin/env bash
# Installs nginx and serves a page containing Holberton School on port 80

export DEBIAN_FRONTEND=noninteractive

run() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    else
        sudo "$@"
    fi
}

run apt-get update -y
run apt-get install -y nginx
echo "Holberton School for the win!" | run tee /var/www/html/index.html > /dev/null
run service nginx restart
