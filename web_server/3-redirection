#!/usr/bin/env bash
# Installs nginx and sets a 301 redirection for /redirect_me

export DEBIAN_FRONTEND=noninteractive

run() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    else
        sudo "$@"
    fi
}

run apt-get update -y
run apt-get install -y nginx
echo "Holberton School for the win!" | run tee /var/www/html/index.html > /dev/null

run tee /etc/nginx/sites-available/default > /dev/null << 'EOF'
server {
    listen 80 default_server;
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }

    location /redirect_me {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }
}
EOF

run nginx -t
run service nginx restart
