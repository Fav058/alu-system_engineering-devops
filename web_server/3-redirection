#!/usr/bin/env bash
# Installs nginx and sets a 301 redirection for /redirect_me

sudo apt-get update -y
sudo apt-get install -y nginx
echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null

if ! grep -q "redirect_me" /etc/nginx/sites-available/default
then
    sudo sed -i 's|server_name _;|server_name _;\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}|' /etc/nginx/sites-available/default
fi

sudo service nginx restart
